+/* aosmap debug hook (local build only): if AOSMAP_CAMFILE names a file containing
+   "x y z tx ty tz" in AoS map coordinates (z down), the spectator camera is placed there,
+   looking at the target. Re-read every frame so an external script can move the camera. */
+static void aosmap_camfile_override() {
+	const char* path = getenv("AOSMAP_CAMFILE");
+	if(!path)
+		return;
+	FILE* f = fopen(path, "r");
+	if(!f)
+		return;
+	float x, y, z, tx, ty, tz;
+	if(fscanf(f, "%f %f %f %f %f %f", &x, &y, &z, &tx, &ty, &tz) == 6) {
+		camera_x = x;
+		camera_y = 63.0F - z;
+		camera_z = y;
+		float dx = tx - x, dup = z - tz, dz = ty - y;
+		float l = sqrtf(dx * dx + dup * dup + dz * dz);
+		if(l > 0.0001F) {
+			camera_rot_y = acosf(dup / l);
+			camera_rot_x = atan2f(dx, dz);
+			camera_overflow_adjust();
+		}
+		camera_movement_x = camera_movement_y = camera_movement_z = 0.0F;
+	}
+	fclose(f);
+}
